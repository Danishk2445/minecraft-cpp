[
  {"_comment": "For each field the first rule (top to bottom) that matches a block and defines the field wins. Expressions: number | prop?a:b | prop*k+c | prop:v0,v1,..."},

  {"match": ["*_leaves", "grass_block", "mangrove_roots"], "layer": "cutout_mipped"},

  {"match": ["glass", "*_stained_glass", "tinted_glass", "ice", "frosted_ice", "slime_block", "honey_block",
             "*glass_pane", "iron_bars"], "skip_same": true},
  {"match": ["air", "cave_air", "void_air", "water", "lava", "short_grass", "tall_grass", "fern", "large_fern",
             "dead_bush", "bush", "vine", "seagrass", "tall_seagrass", "fire", "soul_fire", "light", "structure_void",
             "glow_lichen", "hanging_roots", "crimson_roots", "warped_roots", "nether_sprouts", "leaf_litter",
             "resin_clump", "sculk_vein", "short_dry_grass", "tall_dry_grass"], "replaceable": true},
  {"match": ["snow"], "replaceable": "layers:0,1,0,0,0,0,0,0,0"},

  {"match": ["*_leaves"], "opacity": 1},
  {"match": ["ice", "frosted_ice", "slime_block", "honey_block", "cobweb"], "opacity": 1},
  {"match": ["tinted_glass"], "opacity": 15},

  {"match": ["lava", "fire", "glowstone", "jack_o_lantern", "lantern", "sea_lantern", "shroomlight", "beacon",
             "conduit", "end_gateway", "end_portal", "*_froglight", "lava_cauldron"], "emission": 15},
  {"match": ["redstone_lamp"], "emission": "lit?15:0"},
  {"match": ["copper_bulb", "waxed_copper_bulb"], "emission": "lit?15:0"},
  {"match": ["exposed_copper_bulb", "waxed_exposed_copper_bulb"], "emission": "lit?12:0"},
  {"match": ["weathered_copper_bulb", "waxed_weathered_copper_bulb"], "emission": "lit?8:0"},
  {"match": ["oxidized_copper_bulb", "waxed_oxidized_copper_bulb"], "emission": "lit?4:0"},
  {"match": ["campfire"], "emission": "lit?15:0"},
  {"match": ["torch", "wall_torch", "end_rod"], "emission": 14},
  {"match": ["cave_vines", "cave_vines_plant"], "emission": "berries?14:0"},
  {"match": ["furnace", "smoker", "blast_furnace"], "emission": "lit?13:0"},
  {"match": ["nether_portal"], "emission": 11},
  {"match": ["crying_obsidian", "soul_fire", "soul_torch", "soul_wall_torch", "soul_lantern"], "emission": 10},
  {"match": ["soul_campfire"], "emission": "lit?10:0"},
  {"match": ["redstone_ore", "deepslate_redstone_ore"], "emission": "lit?9:0"},
  {"match": ["redstone_torch", "redstone_wall_torch"], "emission": "lit?7:0"},
  {"match": ["enchanting_table", "ender_chest", "glow_lichen"], "emission": 7},
  {"match": ["sculk_catalyst"], "emission": 6},
  {"match": ["sea_pickle"], "emission": "waterlogged?pickles*3+3:0"},
  {"match": ["respawn_anchor"], "emission": "charges:0,3,7,11,15"},
  {"match": ["*candle_cake"], "emission": "lit?3:0"},
  {"match": ["*candle"], "emission": "lit?candles*3:0"},
  {"match": ["amethyst_cluster"], "emission": 5},
  {"match": ["large_amethyst_bud"], "emission": 4},
  {"match": ["magma_block"], "emission": 3},
  {"match": ["medium_amethyst_bud", "firefly_bush"], "emission": 2},
  {"match": ["small_amethyst_bud", "brewing_stand", "brown_mushroom", "dragon_egg", "end_portal_frame",
             "sculk_sensor", "calibrated_sculk_sensor"], "emission": 1},
  {"match": ["light"], "emission": "level"}
]
