{
  "_comment": [
    "Block loot: what breaking a block drops, as in vanilla 1.21.8 without enchantments (no Silk Touch, no",
    "Fortune) and without explosions. The first rule whose match (and when) fits the block decides; a block",
    "matching no rule drops one of its own item, if it has one. Drops are rolled independently. Rules describe",
    "a harvest with the right tool: blocks that need one drop nothing without it. Checked by tools/check_loot.py."
  ],
  "rules": [
    {
      "_section": "Blocks that never drop anything",
      "_comment": "Technical and unbreakable blocks (vanilla noLootTable or an empty table)",
      "match": [
        "air",
        "bedrock",
        "barrier",
        "light",
        "structure_block",
        "structure_void",
        "jigsaw",
        "command_block",
        "chain_command_block",
        "repeating_command_block",
        "test_block",
        "test_instance_block",
        "end_portal_frame",
        "reinforced_deepslate"
      ],
      "drops": []
    },
    {
      "_comment": "Empty loot tables (a cake's slices are eaten, not dropped)",
      "match": [
        "cake",
        "frogspawn",
        "suspicious_sand",
        "suspicious_gravel",
        "trial_spawner",
        "vault",
        "budding_amethyst"
      ],
      "drops": []
    },
    {
      "_comment": "Vanilla xp is 15 + nextInt(15) + nextInt(15), written here as its range",
      "match": [
        "spawner"
      ],
      "drops": [],
      "xp": [
        15,
        43
      ]
    },
    {
      "_comment": "Silk Touch only, so nothing here (ice still melts into water; a chiseled bookshelf still spills its books)",
      "match": [
        "glass",
        "*_stained_glass",
        "glass_pane",
        "*_stained_glass_pane",
        "ice",
        "packed_ice",
        "blue_ice",
        "small_amethyst_bud",
        "medium_amethyst_bud",
        "large_amethyst_bud",
        "infested_*",
        "*_coral",
        "*_coral_fan",
        "*_coral_wall_fan",
        "bee_nest",
        "turtle_egg",
        "chiseled_bookshelf",
        "mushroom_stem",
        "sculk_vein"
      ],
      "drops": []
    },
    {
      "_comment": "Silk Touch only; 1 xp",
      "match": [
        "sculk"
      ],
      "drops": [],
      "xp": [
        1,
        1
      ]
    },
    {
